# ITFW Live — environment variables (names only, NO real values here)
# Set these in Vercel > Project Settings > Environment Variables.
# The service-role key is server-only and must NEVER be exposed to the browser.
# This static page does not read these yet; they are for the backend when it is wired up.

# Supabase — create a NEW project for ITFW (do NOT reuse the NIPTEI shop project)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-ITFW-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (ITFW's own account — for memberships / DIY / Review / preparation payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# USCIS Case Status API (backend only, never frontend)
USCIS_CLIENT_ID=
USCIS_CLIENT_SECRET=
USCIS_API_BASE_URL=https://api-int.uscis.gov  # Sandbox first; Production only after USCIS approves a live key
