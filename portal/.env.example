# (NOT https://supabase.co — that is the marketing site, not a project.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never NEXT_PUBLIC_:
SUPABASE_SERVICE_ROLE_KEY=

# --- App URL ---
# Correct value: https://immigration.niptei.com (NOT https://niptei.com)
NEXT_PUBLIC_APP_URL=

